# Firebase web app config (Project settings > Your apps). These are public by
# design; access is controlled by firestore.rules. Leave empty to run without
# sign-in (ticks are then kept in the browser only).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
